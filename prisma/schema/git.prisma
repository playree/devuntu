/// 連携する Git ホスティング。GitLab などを足すときはここへ追加する
enum GitProvider {
  github
  gitlab
}

/// GitLab の Webhook の検証方式
enum GitWebhookAuth {
  /// 署名トークン(GitLab 19.0 以降、推奨)。`webhook-signature` の HMAC を検証する
  signing
  /// シークレットトークン(19.0 未満向け)。`X-Gitlab-Token` の値を比べる
  token
}

/// チケットに紐付けた成果物の種別
enum TicketLinkKind {
  branch
  pull_request
  commit
}

/// プルリクエストの状態。branch / commit のリンクでは null
enum PullRequestState {
  open
  draft
  merged
  closed
}

/// 紐付けの経路
enum TicketLinkSource {
  /// MCP / 画面から明示的に登録した
  manual
  /// Webhook がブランチ名の表示IDから登録した
  auto
}

/// チケットに紐付けたブランチ / プルリクエスト / コミット。
/// 状態(prState / headSha)は対応付け済みリポジトリ(BoardRepository)の Webhook で更新する。
model TicketLink {
  id String @id @default(uuid(7))

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  provider GitProvider    @default(github)
  kind     TicketLinkKind

  /// GitLab のインスタンスの URL(`https://gitlab.example.com` など)。GitHub は空文字
  baseUrl String @default("")

  /// GitHub は `owner/name`、GitLab はプロジェクトのパス。大文字小文字を区別しないため小文字で保存する
  repo String

  /// branch: ブランチ名 / pull_request: PR 番号 / commit: SHA
  ref String

  /// 画面から開く URL
  url String

  /// PR のタイトル。Webhook で届くまでは null
  title String?

  prState PullRequestState?

  /// CI 結果(GitCheckSuite)と突き合わせるコミット。PR は head、コミットは ref と同じ値
  headSha String?

  /// 反映済みの PR の updated_at。遅れて届いた古いイベントで状態を巻き戻さないために比べる
  syncedAt DateTime?

  source TicketLinkSource @default(manual)

  /// 自動で付いたリンクを利用者が外した。行を残しておき、次の Webhook で付け直さない
  dismissed Boolean @default(false)

  /// 登録した人。自動リンク・退会では null
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  // メタデータ
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // @@unique が ticketId 先頭の索引を兼ねる
  @@unique([ticketId, provider, baseUrl, repo, kind, ref])
  // Webhook から PR / ブランチのリンクを引く
  @@index([provider, baseUrl, repo, kind, ref])
  @@map("ticket_link")
}

/// ボードとリポジトリの対応付け。Webhook はここにあるリポジトリのイベントだけを扱う。
model BoardRepository {
  id String @id @default(uuid(7))

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  provider GitProvider @default(github)

  /// GitLab のインスタンスの URL。GitHub は空文字
  baseUrl String @default("")

  /// GitHub は `owner/name`、GitLab はプロジェクトのパス(小文字)
  repo String

  /// GitLab の Webhook の検証方式。GitHub は署名方式が1つだけなので null
  webhookAuth GitWebhookAuth?

  /// Webhook のシークレット(GitHub)/ トークン(GitLab)。暗号化して保存する。未設定の間は Webhook を受けない
  webhookSecret String?

  /// 検証を通った Webhook が最後に届いた日時。登録できているかの目安として画面に出す
  lastReceivedAt DateTime?

  // メタデータ
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkSuites GitCheckSuite[]

  @@unique([boardId, provider, baseUrl, repo])
  @@index([provider, baseUrl, repo])
  @@map("board_repository")
}

/// ボードの Git 連携の provider ごとの設定。行が無い provider はすべて既定値として扱う
model BoardGitSetting {
  id String @id @default(uuid(7))

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  provider GitProvider

  /// PR / MR のマージで、紐付いた PR / MR がすべてマージ / クローズされたチケットを完了にする(オプトイン)
  completeOnMerge Boolean @default(false)

  /// 紐付いた PR / MR の CI 失敗・レビュー指摘で、報告済みのエージェント担当チケットを revise へ戻す(オプトイン)
  autoRevise Boolean @default(false)

  /// 1チケットあたりの自動差し戻し回数の上限。回数(Ticket.agentAutoReviseCount)は provider をまたいで数える
  autoReviseLimit Int @default(3)

  // メタデータ
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // @@unique が (boardId, ...) の先頭索引を兼ねるため @@index([boardId]) は不要
  @@unique([boardId, provider])
  @@map("board_git_setting")
}

/// GitHub の Check Suite(CI を実行するアプリごとのまとまり)の最新状態。
/// リンクとは独立に持ち、表示時に headSha で集計する(リンクの登録より先に CI が終わることがあるため)。
model GitCheckSuite {
  id String @id @default(uuid(7))

  provider GitProvider @default(github)

  /// GitLab のインスタンスの URL。GitHub は空文字
  baseUrl String @default("")

  /// GitHub は `owner/name`、GitLab はプロジェクトのパス(小文字)
  repo String

  /// GitHub の check_suite.id / GitLab の pipeline.id
  suiteId String

  /// 受け取った対応付け。シークレットは対応付けごとにボードの管理者が持つため、別のボードの対応付けを
  /// 経由して届いた CI の状態を混ぜないよう、表示時にこのボードの対応付けのものだけを使う
  repositoryId String
  repository   BoardRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  headSha String

  /// 実行したアプリの名前(GitHub Actions など)
  appName String

  /// GitHub の status(queued / in_progress / completed など)。GitLab の pipeline もこの形へ寄せて持つ
  status String

  /// GitHub の conclusion(success / failure など)。完了前は null
  conclusion String?

  /// 反映済みの更新時刻(GitHub は check_suite.updated_at、GitLab はジョブの最後の開始 / 終了時刻)。
  /// 古いイベントで巻き戻さないために比べる
  syncedAt DateTime

  // メタデータ
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, baseUrl, repo, suiteId, repositoryId])
  @@index([provider, baseUrl, repo, headSha])
  // 対応付けの削除で連鎖削除する行を引く
  @@index([repositoryId])
  // 古い行の掃除(maintenance-sweep.ts)
  @@index([updatedAt])
  @@map("git_check_suite")
}
