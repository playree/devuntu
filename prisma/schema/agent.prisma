/// AIエージェント用ユーザーが MCP サーバーへ接続するための長期トークン。
/// 1エージェントにつき1行だけ持ち、再発行はこの行の置き換えで行う。
/// 平文は発行時の応答にしか現れず、保存するのはハッシュだけ。
model AgentToken {
  id String @id @default(uuid(7))

  /// トークンの持ち主となるAIエージェント用ユーザー
  userId String @unique
  user   User   @relation("AgentTokenOwner", fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256(平文) の hex。照合はこの列の一致だけで行う
  tokenHash String @unique

  /// 平文の末尾数文字。管理画面で今のトークンを見分けるためだけに持つ
  hint String

  /// 有効期限。null は無期限
  expiresAt DateTime?

  /// 最終利用時刻。リクエストごとに書かず、一定時間経過した場合だけ更新する
  lastUsedAt DateTime?

  /// 発行操作を行った管理者。ユーザー削除時は SetNull で記録だけ残す
  createdById String?
  createdBy   User?   @relation("AgentTokenCreator", fields: [createdById], references: [id], onDelete: SetNull)

  /// 行の作成時刻ではなく、いま入っているトークンの発行時刻。再発行のたびに書き換える
  createdAt DateTime @default(now())

  @@index([createdById])
  @@map("agent_token")
}

/// 通常ユーザーが MCP サーバーへ接続するための長期トークン(Personal Access Token)。
/// ブラウザを開けない環境から使うための経路で、アカウントページから本人が発行する。
/// 1ユーザーが複数本を持てる。平文は発行時の応答にしか現れず、保存するのはハッシュだけ。
model McpToken {
  id String @id @default(uuid(7))

  /// トークンの持ち主。発行するのは常に本人なので発行者は別に持たない
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 用途を見分けるための名前。持ち主の中で一意
  name String

  /// SHA-256(平文) の hex。照合はこの列の一致だけで行う
  tokenHash String @unique

  /// 平文の末尾数文字。一覧で今のトークンを見分けるためだけに持つ
  hint String

  /// 有効期限。null は無期限
  expiresAt DateTime?

  /// 最終利用時刻。リクエストごとに書かず、一定時間経過した場合だけ更新する
  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  /// 一覧取得の userId 検索もこの索引で引けるので、userId 単独の索引は置かない
  @@unique([userId, name])
  @@map("mcp_token")
}

/// AIエージェントの自動運用(Devuntu Agent)の設定と、ランナーの稼働状況。
/// エージェントユーザーにつき1行だけ持つ。行が無い状態は「自動運用を使わない」を表す。
model AgentRunner {
  id String @id @default(uuid(7))

  /// 自動運用の対象となるAIエージェント用ユーザー
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 自動運用の有効/無効。時間帯の条件を満たしていても、これが false なら動かさない
  enabled Boolean @default(false)

  /// 稼働を許可する時間帯の開始。0:00 からの分。activeToMin と共に null なら終日
  activeFromMin Int?

  /// 稼働を許可する時間帯の終了。0:00 からの分。from > to は日跨ぎ(夜間のみ稼働)を表す
  activeToMin Int?

  /// 時間帯の判定に使うタイムゾーン。null は DEFAULT_TZ
  timezone String?

  /// ランナーへ返すポーリング間隔(秒)
  pollIntervalSec Int @default(300)

  /// エージェントが作業前に読み、処理全体を通じて従う指示(Markdown)
  rule String?

  /// 1日に開始できる実行の上限。0 は無制限
  dailyRunLimit Int @default(0)

  /// 上限のカウントをリセットする時刻。0:00 からの分。判定は timezone に従う
  dailyResetMin Int @default(300)

  /// 月の予算上限(USD)。0 は無制限。月の区切りは毎月1日の dailyResetMin
  monthlyBudgetUsd Decimal @default(0) @db.Decimal(10, 2)

  /// 最終ポーリング時刻。ランナーの自己申告で、稼働状況の表示にだけ使い認可には使わない
  lastPolledAt DateTime?

  /// ランナーが動いているホスト名(自己申告)
  hostname String?

  /// ランナー(devuntu_agent.py)のバージョン(自己申告)
  version String?

  // メタデータ
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relation

  runs   AgentRun[]
  usages AgentUsage[]

  @@map("agent_runner")
}

/// エージェントの1回の実行。稼働状況の確認と、応答が返らないまま落ちた実行の回収に使う。
model AgentRun {
  id String @id @default(uuid(7))

  /// 実行したランナー
  runnerId String
  runner   AgentRunner @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  /// 対象チケット。削除されても履歴は残すので SetNull
  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  /// 起動時点の表示ID。チケット削除後に何を処理したかを追えるように持つ
  ticketRef String?

  /// 実行した処理の種別
  action AgentRunAction

  /// 実行の状態
  status AgentRunStatus @default(running)

  /// エージェントが報告した結果の要約
  summary String?

  /// 実行の開始時刻
  startedAt DateTime @default(now())

  /// 実行の終了時刻。null は実行中、または応答が返らないまま落ちた実行
  finishedAt DateTime?

  // 以降は CLI の出力からランナーが取得して送る計測値。取れない CLI・版では null のまま

  /// 使用したモデル。複数使った場合はコストが最も大きいもの
  model String?

  /// 入力トークン数。キャッシュから読んだぶんを含む
  inputTokens Int?

  /// 入力トークンのうちキャッシュから読んだぶん
  cachedInputTokens Int?

  /// 出力トークン数
  outputTokens Int?

  /// コスト(USD)。CLI が金額を返さない場合(codex)は null
  costUsd Decimal? @db.Decimal(12, 6)

  /// CLI の終了コード。起動できなかった・時間切れで打ち切った場合は null
  exitCode Int?

  /// 計測値を受け取った時刻。月次の集計(AgentUsage)へ二重に加算しないための印
  measuredAt DateTime?

  // 保持期間とランナーごとの件数で `maintenance-sweep.ts` が打ち切る

  @@index([runnerId, startedAt])
  @@index([ticketId])
  @@map("agent_run")
}

/// エージェントの月ごとの利用量(ボード別)。予算上限の判定と、コストの集計表示に使う。
/// 実行履歴(AgentRun)は保持期間と件数で消えるので、月の集計はここへ積み上げて自動メンテナンスの対象にしない。
/// 計測値を受け取るたびに、ランナーの行をロックしたうえで該当する行へ加算する(無ければ作る)。
model AgentUsage {
  id String @id @default(uuid(7))

  runnerId String
  runner   AgentRunner @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  /// 集計する月(YYYY-MM)。ランナーのタイムゾーンで、毎月1日の dailyResetMin を境にする
  month String

  /// 対象チケットのボード。ボードが消えても月の合計(予算の判定)からは外さないので SetNull
  boardId String?
  board   Board?  @relation(fields: [boardId], references: [id], onDelete: SetNull)

  /// 計測値を受け取った実行の数
  runs Int @default(0)

  inputTokens       BigInt @default(0)
  cachedInputTokens BigInt @default(0)
  outputTokens      BigInt @default(0)

  /// コスト(USD)。金額の取れない実行は加算しない
  costUsd Decimal @default(0) @db.Decimal(14, 6)

  updatedAt DateTime @updatedAt

  @@index([runnerId, month])
  @@index([boardId])
  @@map("agent_usage")
}

/// エージェントモードの変更(= 自動実行の承認)を許可する相手。ユーザー指定。
/// 1人も居ないエージェントは誰もエージェントモードを変更できない
model AgentApprover {
  id String @id @default(uuid(7))

  /// 承認対象のAIエージェント用ユーザー
  agentId String
  agent   User   @relation("AgentApproverAgent", fields: [agentId], references: [id], onDelete: Cascade)

  /// 承認者となるユーザー
  userId String
  user   User   @relation("AgentApproverUser", fields: [userId], references: [id], onDelete: Cascade)

  // メタデータ
  createdAt DateTime @default(now())

  // @@unique が (agentId, ...) の先頭索引を兼ねるため @@index([agentId]) は不要
  @@unique([agentId, userId])
  @@index([userId])
  @@map("agent_approver")
}

/// {@link AgentApprover} のグループ指定版。BoardMember / BoardGroup と同じ2枚構成に揃える
model AgentApproverGroup {
  id String @id @default(uuid(7))

  /// 承認対象のAIエージェント用ユーザー
  agentId String
  agent   User   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// 承認者となるグループ。所属ユーザー全員が承認者になる
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // メタデータ
  createdAt DateTime @default(now())

  @@unique([agentId, groupId])
  @@index([groupId])
  @@map("agent_approver_group")
}

/// チケットの処理方式。チケット単位で制御する
enum AgentTaskMode {
  /// パターン1: プランを投稿して一旦終了し、利用者の返信を待つ
  plan
  /// パターン2: プランを作らずに実行して報告する
  auto
}

/// チケットのエージェント処理の状態
enum AgentTaskState {
  /// 未着手
  queued
  /// エージェントが処理中
  running
  /// プラン投稿済み。利用者の返信待ち
  planned
  /// 処理を終えて報告済み
  done
  /// 処理に失敗
  failed
  /// 稼働条件やチケットの内容から処理を見送った
  skipped
}

/// エージェントが行った処理の種別
enum AgentRunAction {
  /// プランの作成と投稿
  plan
  /// 実装の実行
  execute
  /// 返信を受けてのプラン修正。実装まで進んだ場合は完了報告時に execute へ確定する
  revise
}

/// エージェントの1回の実行の状態
enum AgentRunStatus {
  /// 実行中。応答が返らないまま落ちた実行もこの状態で残る
  running
  /// 正常終了
  succeeded
  /// 失敗
  failed
  /// 処理を見送った
  skipped
}
