generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(uuid(7))
  name               String
  email              String
  emailVerified      Boolean             @default(false)
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  role               String?
  banned             Boolean?            @default(false)
  banReason          String?
  banExpires         DateTime?
  twoFactorEnabled   Boolean?            @default(false)
  avatarLocked       Boolean?            @default(false)
  nameLocked         Boolean?            @default(false)
  locale             String?
  lastLoginAt        DateTime?
  sessions           Session[]
  accounts           Account[]
  twofactors         TwoFactor[]
  passkeys           Passkey[]
  oauthclients       OauthClient[]
  oauthrefreshtokens OauthRefreshToken[]
  oauthaccesstokens  OauthAccessToken[]
  oauthconsents      OauthConsent[]
  dashboard          Dashboard?

  // add Group
  userGroups UserGroup[]

  // add CalendarShare
  calendarShare     CalendarShare?
  calendarBusyTimes CalendarBusyTime[]

  // add timezone
  timezone String?

  // add Board / Ticket
  boardMembers    BoardMember[]
  // プライベートボード(1ユーザー1つ)。Board.privateOwnerId の @unique で担保する
  privateBoard    Board?          @relation("PrivateBoardOwner")
  createdTickets  Ticket[]        @relation("TicketCreator")
  assignedTickets Ticket[]        @relation("TicketAssignee")
  ticketComments  TicketComment[] @relation("TicketCommentAuthor")

  // add Attachment
  attachments Attachment[]

  // add Notify
  notifySettings UserNotifySetting[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                 String              @id @default(uuid(7))
  expiresAt          DateTime
  token              String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ipAddress          String?
  userAgent          String?
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy     String?
  oauthrefreshtokens OauthRefreshToken[]
  oauthaccesstokens  OauthAccessToken[]

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid(7))
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id          String   @id @default(uuid(7))
  secret      String
  backupCodes String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified    Boolean? @default(true)

  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

model Passkey {
  id           String    @id @default(uuid(7))
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model Jwks {
  id         String    @id @default(uuid(7))
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                      String    @id @default(uuid(7))
  clientId                String
  clientSecret            String?
  clientDiscoveryId       String?
  disabled                Boolean?  @default(false)
  skipConsent             Boolean?
  enableEndSession        Boolean?
  subjectType             String?
  scopes                  String[]  @default([])
  clientCredentialsScopes String[]  @default([])
  userId                  String?
  user                    User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt               DateTime?
  updatedAt               DateTime?
  name                    String?
  uri                     String?
  icon                    String?
  contacts                String[]  @default([])
  tos                     String?
  policy                  String?
  softwareId              String?
  softwareVersion         String?
  softwareStatement       String?
  redirectUris            String[]  @default([])
  postLogoutRedirectUris  String[]  @default([])

  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?

  tokenEndpointAuthMethod String?
  applicationType         String?
  jwks                    String?
  jwksUri                 String?
  grantTypes              String[]              @default([])
  responseTypes           String[]              @default([])
  requirePKCE             Boolean?
  dpopBoundAccessTokens   Boolean?              @default(false)
  referenceId             String?
  metadata                Json?
  oauthrefreshtokens      OauthRefreshToken[]
  oauthaccesstokens       OauthAccessToken[]
  oauthconsents           OauthConsent[]
  oauthclientresources    OauthClientResource[]

  @@unique([clientId])
  @@index([userId])
  @@map("oauth_client")
}

model OauthRefreshToken {
  id          String      @id @default(uuid(7))
  token       String
  clientId    String
  oauthclient OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId   String?
  session     Session?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId String?

  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]

  expiresAt               DateTime
  createdAt               DateTime           @default(now())
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]
  oauthaccesstokens       OauthAccessToken[]

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauth_refresh_token")
}

model OauthAccessToken {
  id          String      @id @default(uuid(7))
  token       String
  clientId    String
  oauthclient OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId   String?
  session     Session?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId String?

  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]

  refreshId         String?
  oauthrefreshtoken OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt         DateTime
  createdAt         DateTime           @default(now())
  revoked           DateTime?
  confirmation      Json?
  scopes            String[]

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([refreshId])
  @@index([authorizationCodeId])
  @@map("oauth_access_token")
}

model OauthConsent {
  id          String      @id @default(uuid(7))
  clientId    String
  oauthclient OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId String?

  resources               String[]
  requestedUserInfoClaims String[]

  scopes    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consent")
}

/// アクセストークンの発行先となる保護リソース(RFC 8707 の `resource`)。
/// TTL・スコープ・クレームを null にしておくとプラグイン既定値を継承する。
model OauthResource {
  id                            String    @id @default(uuid(7))
  identifier                    String
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?  @default(false)
  disabled                      Boolean?  @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?      @default(1)
  metadata                      Json?

  oauthclientresources OauthClientResource[]

  @@unique([identifier])
  @@map("oauth_resource")
}

/// どのクライアントがどのリソースを要求できるかの中間テーブル。
model OauthClientResource {
  id            String        @id @default(uuid(7))
  clientId      String
  oauthclient   OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId    String
  oauthresource OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata      Json?
  createdAt     DateTime?

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("oauth_client_resource")
}

/// private_key_jwt のクライアントアサーション `jti` の使い捨て記録。
/// id はアサーション由来のダイジェストを better-auth が入れるため既定値は持たない。
model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauth_client_assertion")
}

model Dashboard {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  layout    Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("dashboard")
}

model LinkWidget {
  id          String   @id @default(uuid(7))
  name        String
  url         String
  description String?
  iconPath    String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("link_widget")
}

/// オブジェクトストレージに保存したアップロードファイルのメタデータ。
/// 公開URLは `/api/upload/<key>` で、配信時はここから mimeType を引いて存在確認も兼ねる。
model Attachment {
  id           String   @id @default(uuid(7))
  key          String   @unique
  mimeType     String
  size         Int
  originalName String
  /// 添付先のボード。値がある場合は配信時にそのボードの可視判定を通す。
  /// null は全ログインユーザーへ配信してよいもの(お知らせ / リンクウィジェットのアイコン)
  boardId      String?
  board        Board?   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdById  String?
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([boardId])
  @@map("attachment")
}

model KeyValueStore {
  id        String   @id @default(uuid(7))
  key       String   @unique
  group     String?
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([group])
  @@map("key_value_store")
}

/// アプリバージョンの利用履歴。サーバー起動時(`src/instrumentation.ts`)に upsert で記録し、
/// このDBがどのバージョンでいつ利用されていたかを追跡できるようにする。
/// createdAt が初回起動日時、updatedAt が最終起動日時になる。
model AppVersion {
  id String @id @default(uuid(7))

  /// package.json の version(例: 0.2.2)。同一バージョンは1行に集約するので upsert のキーになる
  version String @unique

  /// 最終起動時のビルド番号(next.config.ts で生成する BUILD_NO)。同一バージョンの再デプロイを識別する
  buildNo   String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("app_version")
}

model Group {
  id          String      @id @default(uuid(7))
  name        String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userGroups  UserGroup[]

  // add Board
  boardGroups BoardGroup[]

  @@map("group")
}

model UserGroup {
  id        String   @id @default(uuid(7))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
  @@map("user_group")
}

model CalendarShare {
  id        String   @id @default(uuid(7))
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicId  String   @unique // 公開URL用のランダムID
  options   Json? // 設定(将来用)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publicId])
  @@map("calendar_share")
}

model CalendarBusyTime {
  id        String   @id @default(uuid(7))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String // 件名(管理画面での識別ラベル。公開カレンダーには非表示)
  weekdays  Int[] // dayjs .day() と同じ 0=日 .. 6=土。1件で複数曜日を保持
  startMin  Int // 0:00 からの分。0..1410、30分刻み
  endMin    Int // 0:00 からの分。30..1440(24:00=1440)、30分刻み。startMin < endMin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("calendar_busy_time")
}

enum BoardMemberRole {
  owner // ボードの権限周りの操作が可能
  member
}

/// ボードの種別。
/// PostgreSQL の enum は宣言順で比較されるため、一覧を `orderBy: { kind: 'asc' }` に
/// したときプライベートが先頭へ来るよう private を先に宣言する。
enum BoardKind {
  private // 1ユーザー1つの個人用ボード。privateOwnerId が所有者
  team // 複数人で共有するボード
}

/// タグの表示色。HeroUI Chip は5色しか持たないため Tailwind パレットへ自前でマップする
enum TagColor {
  gray
  red
  orange
  amber
  green
  teal
  blue
  indigo
  violet
  pink
}

enum TicketStatus {
  backlog // バックログ
  todo // 対応予定
  doing // 対応中
  done // 完了
}

enum TicketPriority {
  urgent // 緊急
  high // 高
  medium // 中
  low // 低
}

model Board {
  id             String            @id @default(uuid(7))
  kind           BoardKind         @default(team)
  // プライベートボードの所有者。team では常に null。
  // PostgreSQL の UNIQUE は NULL を互いに異なる値として扱うため、これ1本で
  // 「1ユーザー1プライベートボード」を担保でき、部分索引が不要になる。
  // kind='private' <=> privateOwnerId IS NOT NULL の整合はアプリ側で保証する
  // (作成経路を ensurePrivateBoard と createBoard の2つに限定している)
  privateOwnerId String?           @unique
  privateOwner   User?             @relation("PrivateBoardOwner", fields: [privateOwnerId], references: [id], onDelete: Cascade)
  // チケット表示ID(`key-number`)の接頭辞。大文字英数(BOARD_KEY_PATTERN)で全ボード一意。
  // 変更すると共有済みの表示IDが解決できなくなるため、変更できるのは owner と管理者に限る
  key            String            @unique
  // 採番済みチケット番号の最大値。UPDATE の行ロックで採番を直列化する。
  // 連番の欠けを避けるためシーケンスではなくこの列で持つ(ロールバック時は番号も戻る)
  ticketSeq      Int               @default(0)
  name           String
  description    String?
  archived       Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  members        BoardMember[]
  groups         BoardGroup[]
  tickets        Ticket[]
  tags           Tag[]
  attachments    Attachment[]
  keyHistories   BoardKeyHistory[]

  @@map("board")
}

/// 過去に使われたボードキーの記録。改名 / 削除でキーを解放しても再利用させないことで、
/// 共有済みの表示ID(`KEY-番号`)が別ボードの同番号チケットへ解決されるのを防ぐ。
/// 行はボードを消しても残す(消すと再利用できてしまうため)。
model BoardKeyHistory {
  key String @id

  /// このキーを使った(使っている)ボード。削除時は SetNull で行だけ残す。
  /// 同じボードがキー変更を戻すのは表示IDの指す先が変わらないので安全で、その判定に使う
  boardId   String?
  board     Board?   @relation(fields: [boardId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([boardId])
  @@map("board_key_history")
}

model Tag {
  id        String      @id @default(uuid(7))
  boardId   String
  board     Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name      String
  color     TagColor    @default(gray)
  // ボード内の表示順。昇順。同値は name 昇順で安定させる
  order     Int         @default(0)
  tickets   TicketTag[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // @@unique が (boardId, ...) の先頭索引を兼ねるため @@index([boardId]) は不要
  @@unique([boardId, name])
  @@map("tag")
}

model TicketTag {
  id        String   @id @default(uuid(7))
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // チケット内のタグの並びは Tag.order を単一ソースにするため order は持たせない
  @@unique([ticketId, tagId])
  @@index([tagId])
  @@map("ticket_tag")
}

model BoardMember {
  id        String          @id @default(uuid(7))
  boardId   String
  board     Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      BoardMemberRole @default(member)
  createdAt DateTime        @default(now())

  // @@unique が (boardId, ...) の先頭索引を兼ねるため @@index([boardId]) は不要
  @@unique([boardId, userId])
  @@index([userId])
  @@map("board_member")
}

model BoardGroup {
  id        String   @id @default(uuid(7))
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([boardId, groupId])
  @@index([groupId])
  @@map("board_group")
}

model Ticket {
  id          String          @id @default(uuid(7))
  // プライベートも必ずボード(kind=private)に属する。所有者による別スコープは持たない
  boardId     String
  board       Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?           @relation("TicketCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  // ボード内の連番(1始まり)。利用者へ見せる表示IDは `Board.key`-`number`(ticketDisplayId)
  number      Int
  title       String
  content     String?
  status      TicketStatus    @default(todo)
  priority    TicketPriority  @default(medium)
  dueDate     DateTime? // 日付のみの概念。UTC 0:00 で保存する
  // status を done にした時刻。done から他のステータスへ戻すと null に戻す
  completedAt DateTime?
  tags        TicketTag[]
  // 同一レーン(boardId + status)内の表示順。昇順・0始まりの連番で保持する。
  // done レーンは盤面に表示されるカードのみを連番の対象とし、表示期限を過ぎた完了の order は据え置く
  order       Int             @default(0)
  comments    TicketComment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // 本文中のメンションを解決した結果。保存時点のスナップショット(TicketComment と同じ扱い)
  mentionedUserIds String[] @default([])

  // @@unique が (boardId, ...) の先頭索引を兼ねるので表示IDからの検索はこれで賄える
  @@unique([boardId, number])
  @@index([boardId, status, order])
  @@index([assigneeId])
  @@index([createdById])
  // チケット一覧の既定の並び順(更新日時の新しい順 + LIMIT)を索引スキャンにする
  @@index([updatedAt])
  @@map("ticket")
}

model TicketComment {
  id               String            @id @default(uuid(7))
  ticketId         String
  ticket           Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // 退会ユーザーのコメントも議論履歴として残すため SetNull(表示は no_name)
  authorId         String?
  author           User?             @relation("TicketCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  content          String
  // null = 通常コメント。plan/report は詳細画面でデフォルト折りたたみ表示する
  type             TicketCommentType?
  // 返信先コメント。1階層のみ許容(親自体が返信の場合は指定できない。制約はアプリ層で検証)
  parentId         String?
  parent           TicketComment?    @relation("TicketCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies          TicketComment[]   @relation("TicketCommentThread")
  mentionedUserIds String[]          @default([])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([ticketId, createdAt])
  @@index([parentId])
  @@map("ticket_comment")
}

enum TicketCommentType {
  plan
  report
}

enum NotifyEvent {
  mention
}

// 行が無い場合は全チャネル OFF として扱う。通知チャネルを増やすときは列を足す。
model UserNotifySetting {
  id        String      @id @default(uuid(7))
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     NotifyEvent
  email     Boolean     @default(false)
  slack     Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // (userId, event) の @@unique が userId 先頭の索引を兼ねるので @@index([userId]) は不要
  @@unique([userId, event])
  @@map("user_notify_setting")
}
