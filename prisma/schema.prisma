generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(uuid(7))
  name               String
  email              String
  emailVerified      Boolean             @default(false)
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  role               String?
  banned             Boolean?            @default(false)
  banReason          String?
  banExpires         DateTime?
  twoFactorEnabled   Boolean?            @default(false)
  locale             String?
  lastLoginAt        DateTime?
  sessions           Session[]
  accounts           Account[]
  twofactors         TwoFactor[]
  passkeys           Passkey[]
  oauthclients       OauthClient[]
  oauthrefreshtokens OauthRefreshToken[]
  oauthaccesstokens  OauthAccessToken[]
  oauthconsents      OauthConsent[]
  dashboard          Dashboard?

  // add Group
  userGroups UserGroup[]

  // add CalendarShare
  calendarShare     CalendarShare?
  calendarBusyTimes CalendarBusyTime[]

  // add timezone
  timezone String?

  // add Board / Ticket
  boardMembers    BoardMember[]
  // プライベートボード(1ユーザー1つ)。Board.privateOwnerId の @unique で担保する
  privateBoard    Board?          @relation("PrivateBoardOwner")
  createdTickets  Ticket[]        @relation("TicketCreator")
  assignedTickets Ticket[]        @relation("TicketAssignee")
  ticketComments  TicketComment[] @relation("TicketCommentAuthor")

  @@unique([email])
  @@map("user")
}

model Session {
  id                 String              @id @default(uuid(7))
  expiresAt          DateTime
  token              String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ipAddress          String?
  userAgent          String?
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy     String?
  oauthrefreshtokens OauthRefreshToken[]
  oauthaccesstokens  OauthAccessToken[]

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid(7))
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id          String   @id @default(uuid(7))
  secret      String
  backupCodes String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified    Boolean? @default(true)

  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

model Passkey {
  id           String    @id @default(uuid(7))
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model Jwks {
  id         String    @id @default(uuid(7))
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?

  @@map("jwks")
}

model OauthClient {
  id                      String              @id @default(uuid(7))
  clientId                String
  clientSecret            String?
  disabled                Boolean?            @default(false)
  skipConsent             Boolean?
  enableEndSession        Boolean?
  subjectType             String?
  scopes                  String[]            @default([])
  userId                  String?
  user                    User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt               DateTime?
  updatedAt               DateTime?
  name                    String?
  uri                     String?
  icon                    String?
  contacts                String[]            @default([])
  tos                     String?
  policy                  String?
  softwareId              String?
  softwareVersion         String?
  softwareStatement       String?
  redirectUris            String[]            @default([])
  postLogoutRedirectUris  String[]            @default([])
  tokenEndpointAuthMethod String?
  grantTypes              String[]            @default([])
  responseTypes           String[]            @default([])
  public                  Boolean?
  type                    String?
  requirePKCE             Boolean?
  referenceId             String?
  metadata                Json?
  oauthrefreshtokens      OauthRefreshToken[]
  oauthaccesstokens       OauthAccessToken[]
  oauthconsents           OauthConsent[]

  @@unique([clientId])
  @@index([userId])
  @@map("oauth_client")
}

model OauthRefreshToken {
  id                String             @id @default(uuid(7))
  token             String
  clientId          String
  oauthclient       OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId         String?
  session           Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId       String?
  expiresAt         DateTime
  createdAt         DateTime           @default(now())
  revoked           DateTime?
  authTime          DateTime?
  scopes            String[]
  oauthaccesstokens OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@map("oauth_refresh_token")
}

model OauthAccessToken {
  id                String             @id @default(uuid(7))
  token             String
  clientId          String
  oauthclient       OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId         String?
  session           Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId            String?
  user              User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId       String?
  refreshId         String?
  oauthrefreshtoken OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt         DateTime
  createdAt         DateTime           @default(now())
  scopes            String[]

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([refreshId])
  @@map("oauth_access_token")
}

model OauthConsent {
  id          String      @id @default(uuid(7))
  clientId    String
  oauthclient OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId String?
  scopes      String[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consent")
}

model Dashboard {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  layout    Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("dashboard")
}

model LinkWidget {
  id          String   @id @default(uuid(7))
  name        String
  url         String
  description String?
  iconPath    String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("link_widget")
}

model KeyValueStore {
  id        String   @id @default(uuid(7))
  key       String   @unique
  group     String?
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([group])
  @@map("key_value_store")
}

model Group {
  id          String      @id @default(uuid(7))
  name        String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userGroups  UserGroup[]

  // add Board
  boardGroups BoardGroup[]

  @@map("group")
}

model UserGroup {
  id        String   @id @default(uuid(7))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
  @@map("user_group")
}

model CalendarShare {
  id        String   @id @default(uuid(7))
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicId  String   @unique // 公開URL用のランダムID
  options   Json? // 設定(将来用)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publicId])
  @@map("calendar_share")
}

model CalendarBusyTime {
  id        String   @id @default(uuid(7))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String // 件名(管理画面での識別ラベル。公開カレンダーには非表示)
  weekdays  Int[] // dayjs .day() と同じ 0=日 .. 6=土。1件で複数曜日を保持
  startMin  Int // 0:00 からの分。0..1410、30分刻み
  endMin    Int // 0:00 からの分。30..1440(24:00=1440)、30分刻み。startMin < endMin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("calendar_busy_time")
}

enum BoardMemberRole {
  owner // ボードの権限周りの操作が可能
  member
}

/// ボードの種別。
/// PostgreSQL の enum は宣言順で比較されるため、一覧を `orderBy: { kind: 'asc' }` に
/// したときプライベートが先頭へ来るよう private を先に宣言する。
enum BoardKind {
  private // 1ユーザー1つの個人用ボード。privateOwnerId が所有者
  team // 複数人で共有するボード
}

/// タグの表示色。HeroUI Chip は5色しか持たないため Tailwind パレットへ自前でマップする
enum TagColor {
  gray
  red
  orange
  amber
  green
  teal
  blue
  indigo
  violet
  pink
}

enum TicketStatus {
  backlog // 未着手
  todo // 対応予定
  doing // 対応中
  done // 完了
}

enum TicketPriority {
  urgent // 緊急
  high // 高
  medium // 中
  low // 低
}

model Board {
  id             String        @id @default(uuid(7))
  kind           BoardKind     @default(team)
  // プライベートボードの所有者。team では常に null。
  // PostgreSQL の UNIQUE は NULL を互いに異なる値として扱うため、これ1本で
  // 「1ユーザー1プライベートボード」を担保でき、部分索引が不要になる。
  // kind='private' <=> privateOwnerId IS NOT NULL の整合はアプリ側で保証する
  // (作成経路を ensurePrivateBoard と createBoard の2つに限定している)
  privateOwnerId String?       @unique
  privateOwner   User?         @relation("PrivateBoardOwner", fields: [privateOwnerId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  archived       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  members        BoardMember[]
  groups         BoardGroup[]
  tickets        Ticket[]
  tags           Tag[]

  @@map("board")
}

model Tag {
  id        String      @id @default(uuid(7))
  boardId   String
  board     Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name      String
  color     TagColor    @default(gray)
  // ボード内の表示順。昇順。同値は name 昇順で安定させる
  order     Int         @default(0)
  tickets   TicketTag[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // @@unique が (boardId, ...) の先頭索引を兼ねるため @@index([boardId]) は不要
  @@unique([boardId, name])
  @@map("tag")
}

model TicketTag {
  id        String   @id @default(uuid(7))
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // チケット内のタグの並びは Tag.order を単一ソースにするため order は持たせない
  @@unique([ticketId, tagId])
  @@index([tagId])
  @@map("ticket_tag")
}

model BoardMember {
  id        String          @id @default(uuid(7))
  boardId   String
  board     Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      BoardMemberRole @default(member)
  createdAt DateTime        @default(now())

  // @@unique が (boardId, ...) の先頭索引を兼ねるため @@index([boardId]) は不要
  @@unique([boardId, userId])
  @@index([userId])
  @@map("board_member")
}

model BoardGroup {
  id        String   @id @default(uuid(7))
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([boardId, groupId])
  @@index([groupId])
  @@map("board_group")
}

model Ticket {
  id          String          @id @default(uuid(7))
  // プライベートも必ずボード(kind=private)に属する。所有者による別スコープは持たない
  boardId     String
  board       Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?           @relation("TicketCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  title       String
  content     String?
  status      TicketStatus    @default(todo)
  priority    TicketPriority  @default(medium)
  dueDate     DateTime? // 日付のみの概念。UTC 0:00 で保存する
  tags        TicketTag[]
  // 同一レーン(boardId + status)内の表示順。昇順・0始まりの連番で保持
  order       Int             @default(0)
  comments    TicketComment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([boardId, status, order])
  @@index([assigneeId])
  @@index([createdById])
  // チケット一覧の既定の並び順(更新日時の新しい順 + LIMIT)を索引スキャンにする
  @@index([updatedAt])
  @@map("ticket")
}

model TicketComment {
  id               String   @id @default(uuid(7))
  ticketId         String
  ticket           Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // 退会ユーザーのコメントも議論履歴として残すため SetNull(表示は no_name)
  authorId         String?
  author           User?    @relation("TicketCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  content          String
  mentionedUserIds String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ticketId, createdAt])
  @@map("ticket_comment")
}
