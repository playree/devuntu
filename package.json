{
  "name": "devuntu",
  "version": "0.3.3",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:domain": "DOTENV_CONFIG_PATH=.env.domain DOTENV_CONFIG_QUIET=true NODE_OPTIONS=\"--require dotenv/config\" next dev",
    "build": "next build && node scripts/patch-standalone.mjs",
    "lint": "eslint",
    "prettier": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore './**/*.{js,jsx,ts,tsx,json,css}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "studio": "prisma studio",
    "db:backup": "./scripts/backup-db.sh",
    "db:restore": "./scripts/restore-db.sh",
    "s3:backup": "node ./scripts/backup-s3.mjs",
    "s3:restore": "node ./scripts/restore-s3.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@better-auth/oauth-provider": "^1.6.28",
    "@better-auth/passkey": "^1.6.28",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@hookform/resolvers": "^5.7.1",
    "@internationalized/date": "^3.12.3",
    "@lexical/react": "0.48.0",
    "@mdxeditor/editor": "^4.2.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-stately/data": "^3.16.1",
    "@sendgrid/mail": "^8.1.6",
    "@zxcvbn-ts/core": "^4.1.2",
    "accept-language-parser": "^1.5.0",
    "better-auth": "^1.6.28",
    "cm6-theme-basic-dark": "^0.2.0",
    "cookie": "^2.0.1",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "framer-motion": "^13.0.0",
    "jose": "^6.2.8",
    "lexical": "0.48.0",
    "nanoid": "^6.0.1",
    "next": "16.3.1",
    "next-safe-action": "^8.6.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "path-to-regexp": "^8.4.2",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "sharp": "0.34.5",
    "tailwind-variants": "^3.3.1",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/mcp": "0.0.79",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/accept-language-parser": "^1.5.8",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.8.1",
    "eslint-config-next": "16.3.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^24.0.0"
