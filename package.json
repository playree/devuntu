{
  "name": "devuntu",
  "version": "0.7.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:domain": "DOTENV_CONFIG_PATH=.env.domain DOTENV_CONFIG_QUIET=true NODE_OPTIONS=\"--require dotenv/config\" next dev",
    "build": "next build && node scripts/patch-standalone.mjs",
    "lint": "eslint",
    "prettier": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore './**/*.{js,jsx,ts,tsx,json,css}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:standalone": "./scripts/test-standalone.sh",
    "typecheck": "next typegen && tsc --noEmit",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "studio": "prisma studio",
    "db:backup": "./scripts/backup-db.sh",
    "db:restore": "./scripts/restore-db.sh",
    "s3:backup": "node ./scripts/backup-s3.mjs",
    "s3:restore": "node ./scripts/restore-s3.mjs",
    "setup:env": "node ./scripts/setup-env/index.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@better-auth/oauth-provider": "^1.7.4",
    "@better-auth/passkey": "^1.7.4",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@heroui/react": "^3.2.5",
    "@heroui/styles": "^3.2.5",
    "@hookform/resolvers": "^5.9.1",
    "@internationalized/date": "^3.12.4",
    "@lexical/react": "0.48.0",
    "@mdxeditor/editor": "^4.2.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-stately/data": "^3.16.1",
    "@sendgrid/mail": "^8.1.6",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "accept-language-parser": "^1.5.0",
    "better-auth": "^1.7.4",
    "cm6-theme-basic-dark": "^0.2.0",
    "cookie": "^2.0.1",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "framer-motion": "^13.2.0",
    "jose": "^6.2.12",
    "lexical": "0.48.0",
    "nanoid": "^6.0.1",
    "next": "16.3.4",
    "next-safe-action": "^8.7.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.3",
    "path-to-regexp": "^8.4.2",
    "pino": "^10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.87.0",
    "sharp": "0.35.3",
    "tailwind-variants": "^3.3.1",
    "uuidv7": "^1.2.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/mcp": "0.0.80",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/accept-language-parser": "^1.5.8",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.10.0",
    "eslint-config-next": "16.3.4",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
