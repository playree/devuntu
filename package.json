{
  "name": "devuntu",
  "version": "1.1.0",
  "description": "Self-hosted project management tool centered on Kanban boards and tickets, with calendar, notifications, MCP server and AI agent integration.",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/playree/devuntu#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/playree/devuntu.git"
  },
  "bugs": {
    "url": "https://github.com/playree/devuntu/issues"
  },
  "scripts": {
    "dev": "next dev",
    "dev:domain": "DOTENV_CONFIG_PATH=.env.domain DOTENV_CONFIG_QUIET=true NODE_OPTIONS=\"--require dotenv/config\" next dev",
    "build": "next build && node scripts/patch-standalone.mjs",
    "lint": "eslint",
    "prettier": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore './**/*.{js,jsx,ts,tsx,json,css}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:standalone": "./scripts/test-standalone.sh",
    "typecheck": "next typegen && tsc --noEmit",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "studio": "prisma studio",
    "db:backup": "node ./scripts/backup-db.mjs",
    "db:restore": "node ./scripts/restore-db.mjs",
    "s3:backup": "node ./scripts/backup-s3.mjs",
    "s3:restore": "node ./scripts/restore-s3.mjs",
    "full:backup": "node ./scripts/backup-all.mjs",
    "full:restore": "node ./scripts/restore-all.mjs",
    "maintenance": "node ./scripts/maintenance.mjs",
    "setup:env": "node ./scripts/setup-env/index.mjs",
    "release:version": "node ./scripts/release-version.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@better-auth/oauth-provider": "^1.7.10",
    "@better-auth/passkey": "^1.7.10",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dnd-kit/dom": "^0.5.1",
    "@dnd-kit/react": "^0.5.1",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@hookform/resolvers": "^5.9.2",
    "@internationalized/date": "^3.12.4",
    "@lexical/react": "0.48.0",
    "@mdxeditor/editor": "^4.3.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-stately/data": "^3.16.1",
    "@sendgrid/mail": "^8.1.6",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "accept-language-parser": "^1.5.0",
    "better-auth": "^1.7.10",
    "cm6-theme-basic-dark": "^0.2.0",
    "cookie": "^2.0.1",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.8",
    "framer-motion": "^14.3.0",
    "jose": "^6.2.12",
    "lexical": "0.48.0",
    "nanoid": "^6.0.2",
    "next": "16.4.2",
    "next-safe-action": "^8.7.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.2",
    "path-to-regexp": "^8.4.2",
    "pino": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "sharp": "0.35.5",
    "tailwind-variants": "^3.3.1",
    "uuidv7": "^1.2.1",
    "web-push": "^3.6.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/mcp": "0.0.83",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/accept-language-parser": "^1.5.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@12.5.1"
}
