# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
manifest-*.yaml

# 資格情報を含む生成ファイル(setup-env で作る)
/seaweedfs-s3.json

# 運用者がコンテナへマウントする設定の置き場(メンテナンスモードのフラグ・コマンド定義・SSH鍵)
/config/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backup
/backup/
*.bak

# work
/.work/
/.plan/
/.config/

# claude local settings
/.claude/settings.local.json

*.pyc
__pycache__/

# エージェントランナーを配布元(public/agent)で直接動かしたときの生成物。
# public 配下は静的配信されるため、トークンを持つ config.json を置いたまま commit しない
/public/agent/config.json
/public/agent/agent.log
/public/agent/agent.lock
